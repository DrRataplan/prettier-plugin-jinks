{
	"name": "prettier-plugin-jinks",
	"version": "1.0.0",
	"description": "Prettier plugin for Jinks Templating files",
	"module": "dist/main.js",
	"main": "dist/main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/DrRataplan/prettier-plugin-jinks"
	},
	"dependencies": {
		"prettier": "^3.8.1",
		"prettier-plugin-xquery": "^1.6.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"typescript": "^6.0.2",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/node": "^25.5.0",
		"semantic-release": "^25.0.3"
	},
	"scripts": {
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**/*.ts' --test-reporter=lcov --test-reporter-destination='lcov.info' --test-reporter=dot --test-reporter-destination=stdout ./test/**/*.ts",
		"test": "node --test **/*.test.ts",
		"build": "tsc",
		"lint": "prettier --write ./**/*.ts",
		"lint-ci": "prettier --check ./**/*.ts"
	},
	"files": [
		"dist"
	],
	"types": "./dist/main.d.ts",
	"author": "Martin Middel",
	"license": "MIT",
	"type": "module"
}
